# ── Supabase (required for private, invitation-only access) ─────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only allowlist. Comma-separated, lowercase. Only these emails can sign in.
ALLOWED_EMAILS=haruka@example.com

# Public URL of the deployed site (used in sign-in emails). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ── Local mode (NOT private) ────────────────────────────────────────────
# Without Supabase, production builds are locked to the setup page.
# Set to true ONLY for a throwaway preview you accept is publicly reachable.
# ALLOW_UNPROTECTED_LOCAL_MODE=false

# ── Pet AI chat (optional) ──────────────────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_. Without it, the pet chat shows a
# friendly "not set up yet" message instead of AI replies.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional: Groq chat model (default: llama-3.3-70b-versatile).
# PET_CHAT_MODEL=llama-3.3-70b-versatile
